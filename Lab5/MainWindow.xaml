<Window x:Class="Lab5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab5"
        mc:Ignorable="d"
        Title="Lab 4 Графічний редактор"
        Height="450"
        Width="800">
        <DockPanel>

                <Menu DockPanel.Dock="Top">

                        <MenuItem Header="Файл">

                                <MenuItem Header="Відкрити..."
                                          Click="OpenFile_Click"/>

                                <MenuItem Header="Зберегти як..."
                                          Click="SaveFile_Click"/>

                                <Separator/>

                                <MenuItem Header="Очистити полотно"
                                          Click="ClearCanvas_Click"/>

                        </MenuItem>

                        <MenuItem Header="Об'єкти">

                                <MenuItem x:Name="pointMenuItem"
                                          Header="Крапка"
                                          IsCheckable="True"
                                          Tag="Point"
                                          Click="OnNotify"/>

                                <MenuItem x:Name="lineMenuItem"
                                          Header="Лінія"
                                          IsCheckable="True"
                                          Tag="Line"
                                          Click="OnNotify"/>

                                <MenuItem x:Name="rectangleMenuItem"
                                          Header="Прямокутник"
                                          IsCheckable="True"
                                          Tag="Rectangle"
                                          Click="OnNotify"/>

                                <MenuItem x:Name="ellipseMenuItem"
                                          Header="Еліпс"
                                          IsCheckable="True"
                                          Tag="Ellipse"
                                          Click="OnNotify"/>

                                <MenuItem x:Name="lineWithCirclesMenuItem"
                                          Header="Лінія з кружечками"
                                          IsCheckable="True"
                                          Tag="LineWithCircles"
                                          Click="OnNotify"/>

                                <MenuItem x:Name="cubeMenuItem"
                                          Header="Каркас куба"
                                          IsCheckable="True"
                                          Tag="Cube"
                                          Click="OnNotify"/>

                        </MenuItem>

                        <MenuItem x:Name="tableMenuItem"
                                  Header="Таблиця"
                                  IsCheckable="True"
                                  Click="ToggleTable_Click"/>

                        <MenuItem Header="Довідка"/>
                </Menu>

                <ToolBar DockPanel.Dock="Top"
                         Background="#EAE5FA"
                         Padding="8,5">

                        <Button Width="95"
                                Height="40"
                                Tag="Point"
                                ToolTip="Малювати крапку"
                                Click="OnNotify">

                                <StackPanel Orientation="Horizontal">
                                        <Canvas x:Name="pointIconCanvas"
                                                Width="40"
                                                Height="32"
                                                ClipToBounds="True"
                                                IsHitTestVisible="False"/>

                                        <TextBlock Text="Крапка"
                                                   Margin="4,0,0,0"
                                                   VerticalAlignment="Center"/>
                                </StackPanel>
                        </Button>

                        <Button Width="90"
                                Height="40"
                                Tag="Line"
                                ToolTip="Малювати лінію"
                                Click="OnNotify">

                                <StackPanel Orientation="Horizontal">
                                        <Canvas x:Name="lineIconCanvas"
                                                Width="40"
                                                Height="32"
                                                ClipToBounds="True"
                                                IsHitTestVisible="False"/>

                                        <TextBlock Text="Лінія"
                                                   Margin="4,0,0,0"
                                                   VerticalAlignment="Center"/>
                                </StackPanel>
                        </Button>

                        <Button Width="140"
                                Height="40"
                                Tag="Rectangle"
                                ToolTip="Малювати прямокутник"
                                Click="OnNotify">

                                <StackPanel Orientation="Horizontal">
                                        <Canvas x:Name="rectangleIconCanvas"
                                                Width="40"
                                                Height="32"
                                                ClipToBounds="True"
                                                IsHitTestVisible="False"/>

                                        <TextBlock Text="Прямокутник"
                                                   Margin="4,0,0,0"
                                                   VerticalAlignment="Center"/>
                                </StackPanel>
                        </Button>

                        <Button Width="95"
                                Height="40"
                                Tag="Ellipse"
                                ToolTip="Малювати еліпс"
                                Click="OnNotify">

                                <StackPanel Orientation="Horizontal">
                                        <Canvas x:Name="ellipseIconCanvas"
                                                Width="40"
                                                Height="32"
                                                ClipToBounds="True"
                                                IsHitTestVisible="False"/>

                                        <TextBlock Text="Еліпс"
                                                   Margin="4,0,0,0"
                                                   VerticalAlignment="Center"/>
                                </StackPanel>
                        </Button>

                        <Button Width="180"
                                Height="40"
                                Tag="LineWithCircles"
                                ToolTip="Малювати лінію з кружечками"
                                Click="OnNotify">

                                <StackPanel Orientation="Horizontal">
                                        <Canvas x:Name="lineWithCirclesIconCanvas"
                                                Width="40"
                                                Height="32"
                                                ClipToBounds="True"
                                                IsHitTestVisible="False"/>

                                        <TextBlock Text="Лінія з кружечками"
                                                   Margin="4,0,0,0"
                                                   VerticalAlignment="Center"/>
                                </StackPanel>
                        </Button>

                        <Button Width="135"
                                Height="40"
                                Tag="Cube"
                                ToolTip="Малювати каркас куба"
                                Click="OnNotify">

                                <StackPanel Orientation="Horizontal">
                                        <Canvas x:Name="cubeIconCanvas"
                                                Width="40"
                                                Height="32"
                                                ClipToBounds="True"
                                                IsHitTestVisible="False"/>

                                        <TextBlock Text="Каркас куба"
                                                   Margin="4,0,0,0"
                                                   VerticalAlignment="Center"/>
                                </StackPanel>
                        </Button>

                </ToolBar>

                <Border DockPanel.Dock="Bottom"
                        Background="#EAE5FA"
                        Padding="12,8">

                        <TextBlock x:Name="shapeCountText"
                                   FontSize="13"
                                   Foreground="#554887"/>

                </Border>

                <Canvas x:Name="drawingCanvas"
                        Background="White"
                        MouseLeftButtonDown="DrawingCanvas_MouseLeftButtonDown"
                        MouseMove="DrawingCanvas_MouseMove"
                        MouseLeftButtonUp="DrawingCanvas_MouseLeftButtonUp"
                        ClipToBounds="True"/>

        </DockPanel>
</Window>
