<Window x:Class="Lab5.MyTableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Таблиця об'єктів"
        Height="430"
        Width="650"
        Background="#F8F6FF">

    <DockPanel Margin="12">

        <CheckBox x:Name="deleteModeCheckBox"
                  DockPanel.Dock="Top"
                  Content="Режим видалення: видаляти фігуру при виборі рядка"
                  Margin="0,0,0,12"
                  Checked="DeleteMode_Checked"/>

        <DataGrid x:Name="objectsGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  SelectionChanged="ObjectsGrid_SelectionChanged"
                  Background="White"
                  RowBackground="White"
                  AlternatingRowBackground="#F0EBFF">

            <DataGrid.Columns>

                <DataGridTextColumn Header="ID"
                                    Binding="{Binding Id}"
                                    Width="50"/>

                <DataGridTextColumn Header="Тип фігури"
                                    Binding="{Binding Type}"
                                    Width="*"/>

                <DataGridTextColumn Header="X1"
                                    Binding="{Binding X1, StringFormat={}{0:0.##}}"
                                    Width="65"/>

                <DataGridTextColumn Header="Y1"
                                    Binding="{Binding Y1, StringFormat={}{0:0.##}}"
                                    Width="65"/>

                <DataGridTextColumn Header="X2"
                                    Binding="{Binding X2, StringFormat={}{0:0.##}}"
                                    Width="65"/>

                <DataGridTextColumn Header="Y2"
                                    Binding="{Binding Y2, StringFormat={}{0:0.##}}"
                                    Width="65"/>

            </DataGrid.Columns>

        </DataGrid>

    </DockPanel>
</Window>