<Window x:Class="Lab1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lab 1"
        Width="800"
        Height="500"
        MinWidth="600"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="#F5F3FA"
        FontFamily="Segoe UI">

    <Grid Margin="35">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,25">

            <TextBlock
                Text="Лабораторна робота №1"
                FontSize="28"
                FontWeight="SemiBold"
                Foreground="#28243D"/>

        </StackPanel>

        <Border Grid.Row="1"
                Background="#EAE5FA"
                CornerRadius="12"
                Padding="10"
                Margin="0,0,0,20">

            <Menu Background="Transparent"
                  BorderThickness="0">

                <MenuItem
                    Header="Робота1"
                    Click="Work1_Click"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="#554887"
                    Padding="16,8"/>

                <MenuItem
                    Header="Робота2"
                    Click="Work2_Click"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="#554887"
                    Padding="16,8"/>

            </Menu>

        </Border>

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="16"
                BorderBrush="#E6E1EF"
                BorderThickness="1"
                Padding="30">

            <StackPanel
                VerticalAlignment="Center"
                HorizontalAlignment="Center">

                <TextBlock
                    Text="РЕЗУЛЬТАТ"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="#9B91B4"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,18"/>

                <TextBlock
                    x:Name="resultText"
                    Text="Оберіть роботу в меню вище"
                    FontSize="23"
                    FontWeight="SemiBold"
                    Foreground="#37304E"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    MaxWidth="500"/>

            </StackPanel>

        </Border>

    </Grid>

</Window>