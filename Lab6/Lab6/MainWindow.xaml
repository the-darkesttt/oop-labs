<Window x:Class="Lab6.MainWindow"
        Closing="MainWindow_Closing"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lab6 Менеджер системи"
        Height="300"
        Width="550"
        WindowStartupLocation="CenterScreen"
        Background="#F8F6FF">

    <DockPanel>

        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Система">

                <MenuItem Header="Виконати..."
                          Click="Run_Click"/>

                <Separator/>

                <MenuItem Header="Вихід"
                          Click="Exit_Click"/>

            </MenuItem>
        </Menu>

        <StackPanel Margin="25">

            <TextBlock Text="Система взаємодії програм"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="#443B65"
                       Margin="0,10,0,15"/>

            <TextBlock Text="Lab6 керує програмами Object2 та Object3."
                       FontSize="14"
                       Margin="0,0,0,8"/>

            <TextBlock Text="Для початку роботи виберіть Система → Виконати."
                       TextWrapping="Wrap"
                       FontSize="14"/>

            <TextBlock x:Name="statusText"
                       TextWrapping="Wrap"
                       Text="Стан: очікування параметрів"
                       FontSize="13"
                       Foreground="#667B55"
                       Margin="0,35,0,0"/>

        </StackPanel>

    </DockPanel>
</Window>