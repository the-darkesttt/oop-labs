<Window x:Class="Object3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Object3 Визначник матриці"
        Height="450"
        Width="550"
        WindowStartupLocation="CenterScreen"
        Background="#F8F6FF">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Обчислення визначника"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="#443B65"
                   Margin="0,0,0,15"/>

        <TextBox x:Name="matrixText"
                 Grid.Row="1"
                 IsReadOnly="True"
                 FontFamily="Consolas"
                 FontSize="16"
                 Background="White"
                 TextWrapping="NoWrap"
                 HorizontalScrollBarVisibility="Auto"
                 VerticalScrollBarVisibility="Auto"/>

        <TextBlock x:Name="resultText"
                   Grid.Row="2"
                   Text="Очікування матриці..."
                   FontSize="18"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Foreground="#667B55"
                   Margin="0,20,0,0"/>

    </Grid>
</Window>