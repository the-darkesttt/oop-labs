<Window x:Class="Lab4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab4"
        mc:Ignorable="d"
        Title="Lab 3 Графічний редактор"
        Height="450"
        Width="800">
        <DockPanel>

                <Menu DockPanel.Dock="Top">
                        <MenuItem Header="Файл"/>
                        <MenuItem Header="Об'єкти">

                                <MenuItem x:Name="pointMenuItem"
                                          Header="Крапка"
                                          IsCheckable="True"
                                          Click="Point_Click"/>

                                <MenuItem x:Name="lineMenuItem"
                                          Header="Лінія"
                                          IsCheckable="True"
                                          Click="Line_Click"/>

                                <MenuItem x:Name="rectangleMenuItem"
                                          Header="Прямокутник"
                                          IsCheckable="True"
                                          Click="Rectangle_Click"/>

                                <MenuItem x:Name="ellipseMenuItem"
                                          Header="Еліпс"
                                          IsCheckable="True"
                                          Click="Ellipse_Click"/>

                                <MenuItem x:Name="lineWithCirclesMenuItem"
                                          Header="Лінія з кружечками"
                                          IsCheckable="True"
                                          Click="LineWithCircles_Click"/>

                                <MenuItem x:Name="cubeMenuItem"
                                          Header="Каркас куба"
                                          IsCheckable="True"
                                          Click="Cube_Click"/>

                        </MenuItem>
                        <MenuItem Header="Довідка"/>
                </Menu>

                <ToolBar DockPanel.Dock="Top"
                         Background="#EAE5FA"
                         Padding="8,5">

                        <Button Content="● Крапка"
                                Width="110"
                                Height="35"
                                ToolTip="Малювати крапку"
                                Tag="Point"
                                Click="OnNotify"/>

                        <Button Content=" / Лінія"
                                Width="110"
                                Height="35"
                                ToolTip="Малювати лінію"
                                Tag="Line"
                                Click="OnNotify"/>

                        <Button Content="▭ Прямокутник"
                                Width="150"
                                Height="35"
                                ToolTip="Малювати прямокутник"
                                Tag="Rectangle"
                                Click="OnNotify"/>

                        <Button Content="○ Еліпс"
                                Width="110"
                                Height="35"
                                ToolTip="Малювати еліпс"
                                Tag="Ellipse"
                                Click="OnNotify"/>

                        <Button Content="◯─◯"
                                Width="80"
                                Height="35"
                                Tag="LineWithCircles"
                                ToolTip="Малювати лінію з кружечками"
                                Click="OnNotify"/>

                        <Button Content="▱ Куб"
                                Width="100"
                                Height="35"
                                Tag="Cube"
                                ToolTip="Малювати каркас куба"
                                Click="OnNotify"/>

                </ToolBar>

                <Border DockPanel.Dock="Bottom"
                        Background="#EAE5FA"
                        Padding="12,8">

                        <TextBlock x:Name="shapeCountText"
                                   Text="Фігур: 0 / 109"
                                   FontSize="13"
                                   Foreground="#554887"/>

                </Border>

                <Canvas x:Name="drawingCanvas"
                        Background="White"
                        MouseLeftButtonDown="DrawingCanvas_MouseLeftButtonDown"
                        MouseMove="DrawingCanvas_MouseMove"
                        MouseLeftButtonUp="DrawingCanvas_MouseLeftButtonUp"
                        ClipToBounds="True"/>

        </DockPanel>
</Window>
